<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="Lab9_Advanced" version="1" scripttimeout="300" countdown="0" lock="0" author="Jun Liu">
  <description>实验九　路由策略的配置  进阶技能</description>
  <body>1）	整个网络运行RIPv2协议，并且在两栋附楼之内的主机不受路由协议影响；
2）	附楼X的192.168.1.0/24网段对附楼Y所连接的网络不可见，附楼Y的192.168.3.0/24对附楼X所连接的网络不可见。</body>
  <topology>
    <nodes>
      <node id="1" name="R1" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="416" top="154">
        <interface id="0" name="e0/0" type="ethernet" network_id="1"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="2"/>
        <interface id="32" name="e0/2" type="ethernet" network_id="6"/>
