        <interface id="32" name="e0/2" type="ethernet" network_id="6"/>
        <interface id="48" name="e0/3" type="ethernet" network_id="7"/>
        <interface id="17" type="serial" name="s1/1" remote_id="2" remote_if="17"/>
      </node>
      <node id="5" name="PC5" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" icon="Desktop.png" config="1" left="884" top="270">
