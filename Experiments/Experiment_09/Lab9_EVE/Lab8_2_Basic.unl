<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="Lab9_Basic" version="1" scripttimeout="300" countdown="0" lock="0" author="Jun Liu">
  <description>实验九　路由策略的配置  基本技能</description>
  <body>使用RIP路由协议和OSPF路由协议使得该网络中的所有网段之间能够相互通信，用户网段中的主机不受路由协议的影响，并且尽可能减小所有路由器的路由表的大小。</body>
  <topology>
    <nodes>
      <node id="1" name="R1" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="359" top="294">
        <interface id="0" name="e0/0" type="ethernet" network_id="1"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="2"/>
        <interface id="32" name="e0/2" type="ethernet" network_id="3"/>
        <interface id="1" type="serial" name="s1/0" remote_id="2" remote_if="1"/>
      </node>
      <node id="2" name="R2" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="549" top="294">
        <interface id="1" type="serial" name="s1/0" remote_id="1" remote_if="1"/>
        <interface id="17" type="serial" name="s1/1" remote_id="3" remote_if="17"/>
