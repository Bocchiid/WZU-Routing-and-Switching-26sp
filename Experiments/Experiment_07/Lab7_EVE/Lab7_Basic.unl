<lab name="Lab7_Basic" version="1" scripttimeout="300" countdown="0" lock="0" author="Jun Liu">
  <description>实验七 BGP的配置与管理  基本技能</description>
  <body>采用BGP与RIP协议的组合使得该网络中的所有网段之间能够相互通信。</body>
  <topology>
    <nodes>
      <node id="1" name="PC1" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" icon="Desktop.png" config="1" left="418" top="347">
        <interface id="0" name="eth0" type="ethernet" network_id="1"/>
      </node>
      <node id="2" name="PC2" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" icon="Desktop.png" config="1" left="628" top="347">
        <interface id="0" name="eth0" type="ethernet" network_id="3"/>
      </node>
      <node id="3" name="PC3" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" icon="Desktop.png" config="1" left="828" top="347">
        <interface id="0" name="eth0" type="ethernet" network_id="5"/>
      </node>
      <node id="5" name="R2" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="631" top="117">
        <interface id="0" name="e0/0" type="ethernet" network_id="3"/>
        <interface id="1" type="serial" name="s1/0" remote_id="4" remote_if="1"/>
        <interface id="17" type="serial" name="s1/1" remote_id="6" remote_if="17"/>
      </node>
      <node id="6" name="R3" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="831" top="117">
        <interface id="0" name="e0/0" type="ethernet" network_id="5"/>
        <interface id="17" type="serial" name="s1/1" remote_id="5" remote_if="17"/>
      </node>
      <node id="4" name="R1" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="423" top="117">
        <interface id="0" name="e0/0" type="ethernet" network_id="1"/>
        <interface id="1" type="serial" name="s1/0" remote_id="5" remote_if="1"/>
      </node>
    </nodes>
    <networks>
      <network id="1" type="bridge" name="Net1" left="407" top="206" visibility="0"/>
      <network id="3" type="bridge" name="Net3" left="597" top="406" visibility="0"/>
      <network id="5" type="bridge" name="Net5" left="477" top="286" visibility="0"/>
    </networks>
  </topology>
