<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="Lab7_Advanced" version="1" scripttimeout="300" countdown="0" lock="0" author="Jun Liu">
  <description>实验七 BGP的配置与管理 进阶技能</description>
  <body>1）在整个网络中，采用BGP实现与ISP的连通。
2）在企业网络的两台路由器上对企业网络进行路由汇总。
3）优先选择总部的边缘路由器R1作为互联网流量进入企业的入口，并优先选择分公司的边缘路由器R3作为访问互联网流量的出口。</body>
  <topology>
    <nodes>
      <node id="1" name="R1" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="558" top="93">
        <interface id="0" name="e0/0" type="ethernet" network_id="2"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="4"/>
        <interface id="1" type="serial" name="s1/0" remote_id="4" remote_if="1"/>
      </node>
      <node id="2" name="R2" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="0" delay="0" icon="Router.png" config="1" left="718" top="233">
        <interface id="0" name="e0/0" type="ethernet" network_id="2"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="3"/>
        <interface id="32" name="e0/2" type="ethernet" network_id="5"/>
      </node>
      <node id="3" name="R3" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="558" top="373">
        <interface id="0" name="e0/0" type="ethernet" network_id="4"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="3"/>
        <interface id="17" type="serial" name="s1/1" remote_id="4" remote_if="17"/>
      </node>
      <node id="4" name="R4" type="iol" template="iol" image="i86bi_linux-l3-adventerprisek9-m-15.4-2T.bin" ethernet="1" nvram="1024" ram="1024" serial="1" delay="0" icon="Router.png" config="1" left="298" top="223">
        <interface id="0" name="e0/0" type="ethernet" network_id="1"/>
        <interface id="1" type="serial" name="s1/0" remote_id="1" remote_if="1"/>
        <interface id="17" type="serial" name="s1/1" remote_id="3" remote_if="17"/>
      </node>
      <node id="5" name="PC1" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" icon="Desktop.png" config="1" left="153" top="219">
        <interface id="0" name="eth0" type="ethernet" network_id="1"/>
      </node>
      <node id="6" name="PC2" type="vpcs" template="vpcs" image="" ethernet="1" delay="0" icon="Desktop.png" config="1" left="778" top="87">
        <interface id="0" name="eth0" type="ethernet" network_id="5"/>
      </node>
    </nodes>
    <networks>
      <network id="1" type="bridge" name="Net1" left="714" top="157" visibility="0"/>
      <network id="2" type="bridge" name="Net2" left="724" top="167" visibility="0"/>
      <network id="3" type="bridge" name="Net3" left="774" top="217" visibility="0"/>
      <network id="4" type="bridge" name="Net4" left="744" top="187" visibility="0"/>
      <network id="5" type="bridge" name="Net5" left="440" top="97" visibility="0"/>
    </networks>
  </topology>
